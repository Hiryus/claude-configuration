{
  "env": {
    "CLAUDE_STREAM_IDLE_TIMEOUT_MS": "600000",
    "API_TIMEOUT_MS": "600000"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "mcp__github__list_issues",
      "mcp__github__pull_request_read",
      "mcp__github__issue_read",
      "mcp__github__list_pull_requests",
      "mcp__github__search_pull_requests",
      "WebSearch"
    ],
    "deny": [
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList",
      "DesignSync",
      "Edit(.env)",
      "EnterPlanMode",
      "EnterWorktree",
      "ExitPlanMode",
      "ExitWorktree",
      "NotebookEdit",
      "PowerShell",
      "PushNotification",
      "RemoteTrigger",
      "Read(.env)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "model": "sonnet",
  "disableClaudeAiConnectors": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --with bashlex python ~/.claude/scripts/pre_shell.py"
          }
        ]
      },
      {
        "matcher": "Edit|Grep|Read|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python ~/.claude/scripts/pre_file_access.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python ~/.claude/scripts/post_markdown.py"
          }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "disableArtifact": true,
  "workflowKeywordTriggerEnabled": false,
  "disableSkillShellExecution": true,
  "defaultShell": "bash",
  "statusLine": {
    "type": "command",
    "command": "uv run python ~/.claude/scripts/statusline_command.py"
  },
  "enabledPlugins": {},
  "spinnerTipsEnabled": false,
  "effortLevel": "high",
  "advisorModel": "opus",
  "awaySummaryEnabled": false,
  "autoUpdatesChannel": "latest",
  "tui": "default",
  "voice": {
    "enabled": false,
    "mode": "hold",
    "autoSubmit": false
  },
  "autoMemoryEnabled": false,
  "showThinkingSummaries": true,
  "theme": "dark",
  "editorMode": "normal",
  "wheelScrollAccelerationEnabled": false
}
