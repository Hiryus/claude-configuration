{
  "advisorModel": "opus",
  "autoUpdatesChannel": "latest",
  "effortLevel": "high",
  "model": "opus",
  "theme": "dark",
  "voiceEnabled": false,
  "enabledPlugins": {},
  "hooks": {
    "PreToolUse": [{
      "matcher": "Bash|PowerShell",
      "hooks": [{
          "type": "command",
          "command": "uv run --with bashlex python scripts/pre_shell.py"
      }]
    }, {
      "matcher": "Edit|Read|Write",
      "hooks": [{
          "type": "command",
          "command": "uv run python scripts/pre_file_access.py"
      }]
    }
  ]},
  "permissions": {
    "allow": [
      "WebSearch"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& '${USERPROFILE}\\.claude\\scripts\\statusline-command.ps1'\""
  },
  "voice": {
    "enabled": false,
    "mode": "hold"
  }
}
