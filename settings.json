{
  "permissions": {
    "allow": [
      "mcp__github__list_issues",
      "mcp__github__pull_request_read",
      "mcp__github__issue_read",
      "mcp__github__list_pull_requests",
      "mcp__github__search_pull_requests",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --with bashlex python ${USERPROFILE}/.claude/scripts/pre_shell.py"
          }
        ]
      },
      {
        "matcher": "Edit|Read|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python ${USERPROFILE}/.claude/scripts/pre_file_access.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& '${USERPROFILE}\\.claude\\scripts\\statusline-command.ps1'\""
  },
  "enabledPlugins": {},
  "effortLevel": "high",
  "advisorModel": "opus",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "theme": "dark",
  "voiceEnabled": false,
  "model": "opus"
}
