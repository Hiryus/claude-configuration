{
  "advisorModel": "opus",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoUpdatesChannel": "latest",
  "defaultShell": "bash",
  "disableAutoMode": "disable",
  "disableArtifact": true,
  "disableBypassPermissionsMode": true,
  "disableClaudeAiConnectors": true,
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "effortLevel": "high",
  "enabledPlugins": {},
  "env": {
    "CLAUDE_STREAM_IDLE_TIMEOUT_MS": "600000",
    "API_TIMEOUT_MS": "600000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --with bashlex python ${USERPROFILE}/.claude/scripts/pre_shell.py"
          }
        ]
      },
      {
        "matcher": "Edit|Read|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python ${USERPROFILE}/.claude/scripts/pre_file_access.py"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__github__list_issues",
      "mcp__github__pull_request_read",
      "mcp__github__issue_read",
      "mcp__github__list_pull_requests",
      "mcp__github__search_pull_requests",
      "WebSearch"
    ],
    "deny": [
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList",
      "DesignSync",
      "Edit(.env)",
      "EnterPlanMode",
      "EnterWorktree",
      "ExitPlanMode",
      "ExitWorktree",
      "NotebookEdit",
      "PowerShell",
      "PushNotification",
      "RemoteTrigger",
      "Read(.env)"
    ]
  },
  "spinnerTipsEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& '${USERPROFILE}\\.claude\\scripts\\statusline_command.ps1'\""
  },
  "theme": "dark",
  "voice": {
    "enabled": false,
    "mode": "hold"
  }
}
